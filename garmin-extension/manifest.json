{
  "manifest_version": 3,
  "name": "Garminshopper",
  "version": "1.0.0",
  "description": "Shows shops, food, water, shelters and other services along the course in the Garmin Connect course planner.",
  "host_permissions": ["https://randoshopper.sloth.fi/*"],
  "web_accessible_resources": [{ "resources": ["logo.svg"], "matches": ["https://connect.garmin.com/*"] }],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://connect.garmin.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://connect.garmin.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
