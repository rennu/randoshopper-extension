{
  "manifest_version": 3,
  "name": "Randoshopper for Ride with GPS",
  "version": "1.0.0",
  "description": "Shows shops, food, water, shelters and other services along the route in the Ride with GPS route planner.",
  "host_permissions": ["https://randoshopper.sloth.fi/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://ridewithgps.com/*", "https://www.ridewithgps.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://ridewithgps.com/*", "https://www.ridewithgps.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
