{
  "manifest_version": 3,
  "name": "Randoshopper",
  "version": "1.0.0",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "description": "Augment bicycle route planner view with shops, restaurants, services and whatnot.",
  "host_permissions": ["https://randoshopper.sloth.fi/*"],
  "web_accessible_resources": [
    {
      "resources": ["logo.svg"],
      "matches": [
        "https://www.komoot.com/*",
        "https://www.komoot.de/*",
        "https://ridewithgps.com/*",
        "https://www.ridewithgps.com/*",
        "https://connect.garmin.com/*",
        "https://web.trailmap.fi/*"
      ]
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
  "content_scripts": [
    {
      "matches": ["https://www.komoot.com/*", "https://www.komoot.de/*"],
      "js": ["komoot.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://ridewithgps.com/*", "https://www.ridewithgps.com/*"],
      "js": ["rwgps.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://connect.garmin.com/*"],
      "js": ["garmin.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.trailmap.fi/*"],
      "js": ["trailmap.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.komoot.com/*",
        "https://www.komoot.de/*",
        "https://ridewithgps.com/*",
        "https://www.ridewithgps.com/*",
        "https://connect.garmin.com/*",
        "https://web.trailmap.fi/*"
      ],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
