{
  "manifest_version": 3,
  "name": "Randoshopper for Komoot",
  "version": "1.0.0",
  "description": "Shows shops, food, water, shelters and other services along the route in the Komoot route planner.",
  "host_permissions": ["https://randoshopper.sloth.fi/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.komoot.com/*", "https://www.komoot.de/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.komoot.com/*", "https://www.komoot.de/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
